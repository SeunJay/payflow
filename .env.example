# Local development only. Copy to .env (cp .env.example .env). Never commit .env.

# Postgres superuser for the container (used only by the init script)
POSTGRES_PASSWORD=postgres_dev_password
# Host port for the Postgres container. Change it (and the two URLs below) if
# something else on your machine already listens on 5432.
POSTGRES_HOST_PORT=5432
# Role passwords created by docker/postgres-init.sh on a fresh volume
PAYFLOW_DB_PASSWORD=payflow_dev_password
SIMULATOR_DB_PASSWORD=simulator_dev_password

# API and worker: the payflow database (payflow role)
DATABASE_URL=postgres://payflow:payflow_dev_password@localhost:5432/payflow
# Simulator: its own simulator database (simulator role)
SIMULATOR_DATABASE_URL=postgres://simulator:simulator_dev_password@localhost:5432/simulator
# API and worker: Valkey
VALKEY_URL=redis://localhost:6379

API_PORT=3000
WORKER_PORT=3100
SIMULATOR_PORT=4000

LOG_LEVEL=info

# API auth (spec 0004). The secret below is for local development only.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
BCRYPT_COST=12
# false so the cookies work over plain http on localhost
COOKIE_SECURE=false
